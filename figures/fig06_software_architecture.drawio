<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Software architecture">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="pi" value="Raspberry Pi (onboard)" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="640" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="srv" value="Edge server (PC)" style="rounded=1;arcSize=5;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="20" width="280" height="510" as="geometry"/>
        </mxCell>

        <mxCell id="cam" value="Camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
