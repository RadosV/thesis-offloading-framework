        <mxCell id="e1" value="images" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="cam" target="hm">
          <mxGeometry relative="1" as="geometry"/>
