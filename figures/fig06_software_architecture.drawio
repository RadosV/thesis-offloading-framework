        </mxCell>
        <mxCell id="hm" value="&lt;b&gt;Hybrid manager&lt;/b&gt;&lt;br&gt;onboard detection (ArUco or YOLO)&lt;br&gt;network conditions · switching policy (P0, P1, P2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="340" height="80" as="geometry"/>
        </mxCell>
