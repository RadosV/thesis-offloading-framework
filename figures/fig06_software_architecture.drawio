        <mxCell id="mc" value="&lt;b&gt;Motor controller&lt;/b&gt;&lt;br&gt;PWM, safety stop, watchdog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
