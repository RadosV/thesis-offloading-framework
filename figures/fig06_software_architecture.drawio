        <mxCell id="e2" value="camera images (ImageZMQ, WiFi)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#1f5fa8;fontColor=#1f5fa8;" edge="1" parent="1" source="hm" target="eb">
