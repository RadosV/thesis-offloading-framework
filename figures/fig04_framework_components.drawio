<mxfile host="app.diagrams.net">
  <diagram id="framework" name="Framework components">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="pi" value="Raspberry Pi (onboard)" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="870" height="610" as="geometry"/>
        </mxCell>
        <mxCell id="srv" value="Edge server (PC)" style="rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="910" y="20" width="280" height="610" as="geometry"/>
        </mxCell>

        <mxCell id="cam" value="Camera input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="det" value="&lt;b&gt;Detection method&lt;/b&gt;&lt;br&gt;onboard (ArUco or YOLO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="off" value="Offload transport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sw" value="&lt;b&gt;Switching policy&lt;/b&gt;&lt;br&gt;Pi or server?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mot" value="Motor control &amp;amp; safety layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="690" y="90" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="us" value="Ultrasonic sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="230" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="net" value="&lt;b&gt;Network conditions&lt;/b&gt;&lt;br&gt;delay or drop answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="420" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge" value="&lt;b&gt;Edge server program&lt;/b&gt;&lt;br&gt;runs the same detection method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="950" y="295" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="tel" value="&lt;b&gt;Telemetry&lt;/b&gt;: logs every control cycle, every switch and every run (CSV / JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="810" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="leg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="950" y="560" width="30" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg2" value="exchangeable part" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="555" width="150" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="cam" target="det">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="cam" target="off">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="frame + capture time (WiFi)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="off" target="edge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="answer (MQTT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="edge" target="net">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="450"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="server answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="sw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="onboard answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="det" target="sw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="command (MQTT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="sw" target="mot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="distance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="us" target="mot">
