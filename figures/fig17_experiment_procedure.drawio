<mxfile host="app.diagrams.net"><diagram id="proc" name="Experiment procedure"><mxGraphModel dx="900" dy="1772" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1772" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Start of session" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="220" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Charge the drive battery and check its voltage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="230" y="136" width="440" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Check that the PWM service and the MQTT broker run on the Pi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="230" y="246" width="440" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Start the motor controller, then switch the ESC on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="230" y="376" width="440" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Start the edge brain on the PC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="230" y="486" width="440" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Start the runner for the block: list of runs, random order, battery voltage recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="230" y="596" width="440" height="90" as="geometry"/></mxCell><mxCell id="c8" value="Place the car at the start mark (left or right, as shown by the runner)" st